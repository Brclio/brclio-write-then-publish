# 复制为 .dev.vars，仅用于本地 wrangler dev。生产环境在 Cloudflare 配置。
STORAGE_PROVIDER=github
GITHUB_OWNER=your-account
GITHUB_REPO=your-private-data-repository
GITHUB_BRANCH=main
GITHUB_DATA_PREFIX=write-then-publish
GITHUB_TOKEN=replace-with-private-repository-contents-read-write-token
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
